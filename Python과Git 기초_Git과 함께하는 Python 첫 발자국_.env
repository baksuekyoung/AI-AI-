OPENAI_API_KEY="sk-..."
KAKAO_API_KEY="카카오_개발자_키_입력"
my_travel_planner/
├── .env                  # 비밀 열쇠를 숨겨두는 곳
├── travel_planner.py     # 진짜 코드가 들어갈 메인 프로그램 파일
└── results/              # 결과물(JSON, Markdown)이 저장될 폴더
import os
import sys
import json
import argparse
from datetime import datetime
from dotenv import load_dotenv
import requests
from openai import OpenAI

# 1. .env 파일에서 비밀 열쇠 불러오기
load_dotenv()
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
KAKAO_API_KEY = os.getenv("KAKAO_API_KEY")

# 열쇠가 없으면 프로그램이 시작도 안 하고 친절하게 알려줍니다!
if not OPENAI_API_KEY:
    print("[오류] OPENAI_API_KEY가 설정되지 않았습니다. .env 파일을 확인해주세요.")
    sys.exit(1)

client = OpenAI(api_key=OPENAI_API_KEY)

def get_llm_recommendation(date_str):
    """1단계: LLM에게 날짜를 주고 여행지 추천(JSON)을 받습니다."""
    prompt = f"""
    사용자가 입력한 여행 날짜: {date_str}
    이 시기에 국내에서 여행하기 좋은 도시 1곳을 추천해주세요.
    반드시 아래의 JSON 형식만 딱 맞춰서 텍스트로 대답해주세요. 다른 말은 붙이지 마세요.
    
    {{
      "recommended_city": "도시이름 (예: 제주, 강릉)",
      "weather": "해당 시기 일반적 날씨 요약",
      "events": ["행사1", "행사2"],
      "reason": "추천 근거 2~4문장"
    }}
    """
    
    try:
        response = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": prompt}],
            response_format={"type": "json_object"}
        )
        return json.loads(response.choices[0].message.content), None
    except Exception as e:
        return None, {"step": "llm_recommendation", "type": "API_ERROR", "message": str(e)}

def search_restaurants(city_name):
    """2단계: 지도 API(카카오)를 이용해 해당 도시의 맛집 5곳을 검색합니다."""
    if not KAKAO_API_KEY:
        return [], {"step": "place_search", "type": "AUTH_ERROR", "message": "Kakao API Key missing"}

    url = f"https://dapi.kakao.com/v2/local/search/keyword.json?query={city_name} 맛집"
    headers = {"Authorization": f"KakaoAK {KAKAO_API_KEY}"}
    
    try:
        res = requests.get(url, headers=headers)
        if res.status_code != 200:
            return [], {"step": "place_search", "type": "HTTP_ERROR", "message": f"HTTP {res.status_code}"}
        
        data = res.json()
        documents = data.get("documents", [])
        
        if not documents:
            return [], {"step": "place_search", "type": "EMPTY_RESULT", "message": "0 results found"}
        
        restaurants = []
        for doc in documents[:5]: # 최대 5개만 챙기기
            restaurants.append({
                "name": doc.get("place_name"),
                "address": doc.get("road_address_name") or doc.get("address_name"),
                "category": doc.get("category_name"),
                "url": doc.get("place_url"),
                "x": doc.get("x"),
                "y": doc.get("y")
            })
        return restaurants, None
    except Exception as e:
        return [], {"step": "place_search", "type": "UNKNOWN_ERROR", "message": str(e)}

def generate_final_report(plan_data, restaurants, date_str):
    """3단계: 추천 정보와 맛집 정보를 조합해 최종 마크다운 리포트를 만듭니다."""
    prompt = f"""
    아래 데이터를 바탕으로 멋진 국내 여행 추천 리포트를 Markdown 형식으로 작성해줘.
    
    [여행 날짜]: {date_str}
    [1차 추천 정보]: {json.dumps(plan_data, ensure_ascii=False)}
    [맛집 목록]: {json.dumps(restaurants, ensure_ascii=False)}
    
    포함할 내용:
    - 추천 지역 + 추천 이유 요약
    - 날씨 요약
    - 행사/축제 목록
    - 맛집 리스트 (맛집이 없으면 "데이터 없음"으로 표기)
    - 1일 일정 제안 (오전/오후/저녁)
    """
    
    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}]
    )
    return response.choices[0].message.content

def main():
    # CLI 옵션 설정 (-date "YYYY-MM-DD")
    parser = argparse.ArgumentParser(description="API 활용 국내 여행지 추천 프로그램")
    parser.add_argument("-date", required=True, help="여행 날짜 (예: 2026-03-15)")
    args = parser.parse_args()
    
    date_str = args.date
    
    # 날짜 형식 간단 검증
    try:
        datetime.strptime(date_str, "%Y-%m-%d")
    except ValueError:
        print("[오류] 날짜 형식이 올바르지 않습니다. YYYY-MM-DD 형식으로 입력해주세요. (예: 2026-03-15)")
        sys.exit(1)

    errors = []

    print(f"\n[1/3] 1차 추천 생성 중(LLM)...")
    plan_data, err = get_llm_recommendation(date_str)
    if err:
        errors.append(err)
        plan_data = {"recommended_city": "제주", "weather": "정보 없음", "events": [], "reason": "오류로 인해 기본값으로 대체되었습니다."}
    print(f"    - recommended_city: {plan_data.get('recommended_city')}")

    print(f"[2/3] 맛집 검색 중(지도/장소 API)...")
    city = plan_data.get("recommended_city", "서울")
    restaurants, err = search_restaurants(city)
    if err:
        errors.append(err)
        print(f"    - 맛집 검색 오류 발생 또는 결과 없음 (데이터 없음 처리)")
    else:
        print(f"    - 맛집 {len(restaurants)}곳 검색 완료")

    print(f"[3/3] 최종 리포트 생성 중(LLM)...")
    markdown_report = generate_final_report(plan_data, restaurants, date_str)

    # results 폴더가 없으면 자동으로 만들기
    os.makedirs("results", exist_ok=True)

    # 원본 데이터 JSON 저장
    raw_data = {
        "date": date_str,
        "plan_data": plan_data,
        "restaurants": restaurants,
        "errors": errors
    }
    json_path = f"results/{date_str}_travel_data.json"
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(raw_data, f, ensure_ascii=False, indent=4)

    # 최종 Markdown 리포트 저장
    md_path = f"results/{date_str}_travel_plan.md"
    with open(md_path, "w", encoding="utf-8") as f:
        f.write(markdown_report)
        # 오류가 있다면 리포트 하단에 오류 요약 추가
        if errors:
            f.write("\n\n## 오류 요약 (Errors)\n")
            for e in errors:
                f.write(f"- **Step**: {e['step']} | **Type**: {e['type']} | **Message**: {e['message']}\n")

    print(f"\n완료! results/{date_str}_travel_plan.md 파일을 확인하세요! 🎉")

if __name__ == "__main__":
    main()